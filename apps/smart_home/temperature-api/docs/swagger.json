                },
                "location": {
                    "type": "string",
                    "example": "Living Room"
                },
                "name": {
                    "type": "string",
                    "example": "Living Room Sensor"
                },
                "status": {
                    "type": "string",
                    "example": "active"
                },
                "type": {
                    "type": "string",
                    "example": "temperature"
                },
                "unit": {
                    "type": "string",
                    "example": "°C"
                },
                "value": {
                    "type": "number",
                    "example": 22.5
                }
            }
        },
        "main.TemperatureResponse": {
            "type": "object",
            "properties": {
                "location": {
                    "type": "string"
                },
                "sensorId": {
                    "type": "string"
                },
